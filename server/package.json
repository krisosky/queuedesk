{
  "name": "walk-in-queue-server",
  "version": "0.1.0",
  "author": "Kris Olakulehin",
  "private": true,
  "type": "module",
  "description": "Database and queue model layer for a single-location walk-in queue",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "npm run build && node tests/integration.mjs",
    "staff:create": "npm run build && node dist/scripts/create-staff.js",
    "staff:promote-admin": "npm run build && node dist/scripts/promote-admin.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
